<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VrPiano.Web</RootNamespace>
    <!-- O motor serializa eventos por reflexão; sem trimming nada some no publish. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\domain\VrPiano.Dominio.csproj" />
  </ItemGroup>

  <!-- O mesmo conteúdo que o app em Unity vai usar, embutido no assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\content\*.json" LogicalName="content/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\content\songs\*.json" LogicalName="content/songs/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
